<mjml>
  <mj-include path="./components/head.mjml" />

  <mj-body>
    <mj-include path="./components/logo.mjml" />

    <mj-section mj-class="body-section" padding-bottom="0px">
      <mj-column>
        <mj-text font-size="24px" font-weight="700" line-height="140%"
          >Payment Successful
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-section padding-top="20px" mj-class="body-section">
      <mj-column >
        <mj-text padding-bottom="20px">Hi {{first_name}}!</mj-text>
        <mj-text padding-bottom="20px">
          You have made a payment of <mj-text style="font-weight: 700">NGN 50,000</mj-text> to [Merchant name]. 
        </mj-text>
        <mj-text padding-bottom="20px">Below are the details of the transaction.</mj-text>
      </mj-column>
    </mj-section>

    <mj-section padding-top="0px" padding-bottom="0" mj-class="body-section">
      <mj-column>
        <mj-text font-size='16px' font-weight="700">Transaction Details</mj-text>
      </mj-column>
    </mj-section>
    
    <mj-wrapper mj-class="body-section" padding-top="10px">
      <mj-section background-color="#F9F9F9" padding-left="14px" padding-right="14px" padding-top="5px" padding-bottom="5px">
        <mj-column padding="12px" width='50%'>
          <mj-text  font-size="14px">Transaction Amount</mj-text>
        </mj-column>
        <mj-column padding="12px" width='50%'>
          <mj-text  font-size="14px" align='right'>USD 2,500</mj-text>
        </mj-column>
      </mj-section>

      <mj-section mj-class="body-section" padding-left="14px" padding-right="14px" padding-top="0" padding-bottom="0">
        <mj-divider
          border-width="4px"
          border-style="solid"
          border-color="#ffffff"
        />
      </mj-section>

      <mj-section background-color="#F9F9F9" padding-left="14px" padding-right="14px" padding-top="5px" padding-bottom="5px">
        <mj-column padding="12px" width='50%'>
          <mj-text  font-size="14px">Reference</mj-text>
        </mj-column>
        <mj-column padding="12px" width='50%'>
          <mj-text  font-size="14px" align='right'>Ufew34F3RT34GQVQ</mj-text>
        </mj-column>
      </mj-section>

      <mj-section padding-left="14px" padding-right="14px" padding-top="0" padding-bottom="0">
        <mj-divider
          border-width="4px"
          border-style="solid"
          border-color="#ffffff"
        />
      </mj-section>

      <mj-section background-color="#F9F9F9" padding-left="14px" padding-right="14px" padding-top="5px" padding-bottom="5px">
        <mj-column padding="12px" width='20%'>
          <mj-text  font-size="14px">Address</mj-text>
        </mj-column>
        <mj-column padding="12px" width='80%'>
          <mj-text  font-size="14px" align='right'>9BD9FB9IS9BDUSYDVYUASJNJSUBIASIUASI8AUSBIWQ</mj-text>
        </mj-column>
      </mj-section>

      <mj-section padding-left="14px" padding-right="14px" padding-top="0" padding-bottom="0">
        <mj-divider
          border-width="4px"
          border-style="solid"
          border-color="#ffffff"
        />
      </mj-section>
            <mj-section background-color="#F9F9F9" padding-left="14px" padding-right="14px" padding-top="5px" padding-bottom="5px">
        <mj-column padding="12px" width='50%'>
          <mj-text  font-size="14px" padding-top="10px">Hash</mj-text>
        </mj-column>
        <mj-column padding="12px" width='50%'>
          <mj-text  font-size="14px" align='right'>#FDFUDIU8787WVEEWE</mj-text>
        </mj-column>
      </mj-section>

      <mj-section padding-left="14px" padding-right="14px" padding-top="0" padding-bottom="0">
        <mj-divider
          border-width="4px"
          border-style="solid"
          border-color="#ffffff"
        />
      </mj-section>
            <mj-section background-color="#F9F9F9" padding-left="14px" padding-right="14px" padding-top="5px" padding-bottom="5px">
        <mj-column padding="12px" width='50%'>
          <mj-text  font-size="14px" padding-top="10px">Network</mj-text>
        </mj-column>
        <mj-column padding="12px" width='50%'>
          <mj-text  font-size="14px" align='right'>Ethereum</mj-text>
        </mj-column>
      </mj-section>

      <mj-section padding-left="14px" padding-right="14px" padding-top="0" padding-bottom="0">
        <mj-divider
          border-width="4px"
          border-style="solid"
          border-color="#ffffff"
        />
      </mj-section>
      
      <mj-section background-color="#F9F9F9" padding-left="14px" padding-right="14px" padding-top="5px" padding-bottom="5px">
        <mj-column padding="12px" width='50%'>
          <mj-text  font-size="14px">Date</mj-text>
        </mj-column>
        <mj-column padding="12px" width='50%'>
          <mj-text  font-size="14px" align='right'>7th Dec 2024</mj-text>
        </mj-column>
      </mj-section>
    </mj-wrapper>

    <mj-section mj-class="body-section">
      <mj-column>
        <mj-text font-size='16px' font-weight="700">Important</mj-text>
        <mj-text padding-bottom="20px">
          If you have any issues with this transaction, you can contact our support team via email at <a class="link" 
          style="text-decoration: none"
            rel="noopener"
            href="mailto:support@busha.co?subject=&body="
            target="_blank">support@busha.co</a>, or chat with us via in-app chat.</mj-text>
        <mj-text>If you believe you received this email erroneously, please ignore.</mj-text>
      </mj-column>
    </mj-section>

    <mj-include path="./components/with-love-busha.mjml" />

    <mj-include path="./components/footer-alt-new.mjml" />
  </mj-body>
</mjml>
